    {
      "name": "API-04 POST /users",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
              "const b = pm.response.json();",
              "pm.test(\"name/job renvoyés\", () => { pm.expect(b.name).to.eql(\"morpheus\"); pm.expect(b.job).to.eql(\"leader\"); });",
              "pm.test(\"id et createdAt présents\", () => { pm.expect(b).to.have.property(\"id\"); pm.expect(b).to.have.property(\"createdAt\"); });",
              "pm.collectionVariables.set(\"createdId\", b.id);",
              "pm.test(\"Temps de réponse < 3000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"morpheus\",\n  \"job\": \"leader\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }

{
  "info": {
    "name": "QAOps - Reqres API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection de tests API pour Reqres.in (statut HTTP, contenu JSON, structure)."
  },
  "item": [
    {
      "name": "API-01 GET /users?page=2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "const b = pm.response.json();",
              "pm.test(\"Structure de la liste\", () => { pm.expect(b).to.have.all.keys(\"page\",\"per_page\",\"total\",\"total_pages\",\"data\",\"support\"); });",
              "pm.test(\"page == 2\", () => pm.expect(b.page).to.eql(2));",
              "pm.test(\"Chaque user a les bons champs\", () => b.data.forEach(u => pm.expect(u).to.have.all.keys(\"id\",\"email\",\"first_name\",\"last_name\",\"avatar\")));",
              "pm.test(\"Content-Type JSON\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\"));",
              "pm.test(\"Temps de réponse < 3000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "x-api-key",
            "value": "{{apiKey}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/users?page=2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users"
          ],
          "query": [
            {
              "key": "page",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "API-02 GET /users/2",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
              "const u = pm.response.json().data;",
              "pm.test(\"id == 2\", () => pm.expect(u.id).to.eql(2));",
              "pm.test(\"email valide\", () => pm.expect(u.email).to.match(/^[^@\\s]+@[^@\\s]+$/));",
              "pm.test(\"Temps de réponse < 3000 ms\", () => pm.expect(pm.response.responseTime).to.be.below(3000));"
            ]
          }
        }
